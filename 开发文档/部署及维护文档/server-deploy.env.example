# 宇小兔读书 — 服务器自动化部署配置
# 用法：
#   1. 复制为 server-deploy.env 并修改下方值
#   2. 与 server-deploy.sh、部署包 tar.gz 一并上传到服务器 /root/
#   3. 在服务器执行：sudo bash /root/server-deploy.sh

# ---------- 本机 upload-and-deploy.ps1 使用 ----------
SERVER_IP=175.178.119.166
# 腾讯云 Ubuntu 轻量服务器默认用户为 ubuntu（不是 root）
SERVER_USER=ubuntu
# SSH 私钥路径（留空则自动使用 ~/.ssh/id_ed25519 或 id_rsa）
# SSH_KEY_PATH=C:\Users\你的用户名\.ssh\id_ed25519

# ---------- 必填 ----------
# 网站域名或公网 IP（不要带 http://）
DOMAIN=www.yuxiaotubook.com

# MySQL root 密码（install-all 与 DATABASE_URL 共用；若使用独立业务账号见 MYSQL_USER）
MYSQL_USER=root
MYSQL_PASSWORD=ChangeMe_Strong_Password_123!

# ---------- 可选 ----------
# JWT 密钥（留空则脚本自动生成 48 位随机串）
JWT_SECRET=

# 部署包路径（留空则自动使用 /root/yuxiaotu-book-ubuntu2404-*.tar.gz 最新文件）
TAR_PATH=

# 项目根目录（默认即可）
PROJECT_ROOT=/usr/local/projects/yuxiaotu

# HTTP 端口
HTTP_PORT=80

# 是否初始化演示数据（首次部署 true，更新代码时 false）
RUN_SEED=true

# 是否安装 Docker/Node/MySQL（更新代码时可 false）
INSTALL_ENV=true

# 是否部署后执行视频/电子书数据脚本
RUN_DATA_SCRIPTS=true

# 首页展览视频素材目录（留空则默认使用 网站素材/首页展览素材；部署时 scp 到 ~/homePage/）
# 服务器存储目录：/usr/local/projects/yuxiaotu/data/uploads/homePage
# HOME_EXHIBITION_DIR=E:\AI项目\YuXiaoTuAIGC\YuXiaoTuBook\网站素材\首页展览素材

# 图书解读视频素材目录（留空则默认使用 网站素材/图书页面素材；部署时 scp 到 ~/bookReview/）
# 服务器存储目录：/usr/local/projects/yuxiaotu/data/uploads/bookReview
# BOOK_REVIEW_DIR=E:\AI项目\YuXiaoTuAIGC\YuXiaoTuBook\网站素材\图书页面素材

# CORS（留空则根据 DOMAIN 自动生成）
# CORS_ORIGINS=http://www.yuxiaotubook.com,https://www.yuxiaotubook.com

# 生产开关
DEBUG=false
MOCK_PAY_ENABLED=false
MEMBER_MOCK_PAY_ENABLED=false

# AI 内容生成（OpenAI 兼容；不填 Key 则线上为 Mock 模式，页面可用）
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_TIMEOUT_SECONDS=60
# AI_MOCK_ENABLED=true
