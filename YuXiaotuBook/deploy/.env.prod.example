# 生产环境变量模板
# 首次部署：./scripts/setup-server-dirs.sh 会复制到 /usr/local/projects/yuxiaotu/env/prod.env
# 注意：.env 含真实密码，已在 .gitignore，切勿提交 Git

# ---------- 服务器目录（Ubuntu 生产默认布局）----------
PROJECT_ROOT=/usr/local/projects/yuxiaotu
UPLOAD_DATA_DIR=/usr/local/projects/yuxiaotu/data/uploads
BACKUP_DIR=/var/backups/yuxiaotu/mysql

DOMAIN=yourdomain.com
HTTP_PORT=80

# ---------- 宿主机 MySQL（系统安装，非 Docker）----------
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=yuxiaotu_book

# Python API（密码含特殊字符须 URL 编码，例如 @ → %40）
# 示例：密码 Ab@c123 则写 mysql://root:Ab%40c123@host.docker.internal:3306/yuxiaotu_book
DATABASE_URL="mysql://root:your_url_encoded_password@host.docker.internal:3306/yuxiaotu_book"

# Java trade（JDBC 主机用 host.docker.internal；明文密码写在 MYSQL_PASSWORD）
JDBC_DATABASE_URL="jdbc:mysql://host.docker.internal:3306/yuxiaotu_book?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC"

# ---------- 应用 ----------
JWT_SECRET=ChangeMe_Random_String_At_Least_32_Chars
CORS_ORIGINS="https://yourdomain.com"
DEBUG=false
MOCK_PAY_ENABLED=false
MEMBER_MOCK_PAY_ENABLED=false
PAYMENT_PROVIDER=mock
JWT_EXPIRE_HOURS=168
GUEST_VIDEO_PREVIEW_SECONDS=180
ORDER_TIMEOUT_MINUTES=30
JAVA_OPTS="-Xms256m -Xmx512m"

# AI 内容生成（OpenAI 兼容协议）。不填 AI_API_KEY 时默认 Mock
# AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MOCK_ENABLED=true
